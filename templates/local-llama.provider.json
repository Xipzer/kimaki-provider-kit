{
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "http://<LLM_HOST_IP>:8080/v1",
        "apiKey": "local-no-auth"
      },
      "models": {
        "<MODEL_ID_FROM_/v1/models>": {
          "name": "Local Model",
          "tool_call": true,
          "reasoning": false,
          "attachment": false,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0
          }
        }
      }
    }
  }
}
