{
  "provider": {
    "vllm-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (local)",
      "options": {
        "baseURL": "http://<VLLM_HOST_IP>:8000/v1",
        "apiKey": "local-no-auth"
      },
      "models": {
        "<MODEL_ID_SERVED_BY_VLLM>": {
          "name": "vLLM Model",
          "tool_call": true,
          "reasoning": false,
          "attachment": false,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0
          }
        }
      }
    }
  }
}
